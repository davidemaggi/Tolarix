# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
web/dist/
web/node_modules/.tmp/
*.tsbuildinfo
/dist/
/bin/
core/bin/
# Embedded web build: generated by `pnpm build`; only the placeholder is tracked.
core/internal/webui/dist/*
!core/internal/webui/dist/.gitkeep

# --- Go ---
*.exe
*.test
*.out
coverage.*
go.work
go.work.sum

# --- Tauri / Rust (desktop, milestone 7) ---
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/

# --- Test & tooling artifacts ---
web/coverage/
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/

# --- Local runtime data: never commit databases or secret keys ---
/data/
*.db
*.db-shm
*.db-wal
secret.key
.env
.env.*
!.env.example

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json
